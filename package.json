{
  "name": "alliance-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alliance: a small online strategy game of alliances and betrayals on a hex grid",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/main.ts",
    "start:test": "node server/main.ts --test-mode --db ./data/alliance-test.db",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "test": "node --test \"server/test/*.test.ts\"",
    "admin": "node server/cli.ts"
  },
  "dependencies": {
    "flag-icons": "^7.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
